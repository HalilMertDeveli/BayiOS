# BayiOS — örnek ortam değişkenleri. GERÇEK DEĞER YAZMAYIN.
# Kopyalayın: .env (repo'ya girmez). Preview/production değerleri sağlayıcıların secret yönetiminde tutulur.

# --- API (services/api) ---
# Çalışma zamanı bağlantısı: yalnızca bayios_app rolü (NOBYPASSRLS, tablo sahibi değil).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=bayios;Username=bayios_app;Password=change-me-local-only
# Yalnızca migration adımı (dotnet ef database update / CI): bayios_migrator. API'ye verilmez.
ConnectionStrings__Migrator=Host=localhost;Port=5432;Database=bayios;Username=bayios_migrator;Password=change-me-local-only
Auth__Authority=https://<supabase-project-ref>.supabase.co/auth/v1
Auth__Audience=authenticated
# Opsiyonel; varsayılan {Auth__Authority}/.well-known/jwks.json
Auth__JwksUrl=
# Yalnızca yerel Supabase CLI (http) için false; bkz. infra/supabase/local/README.md
Auth__RequireHttpsMetadata=
# Dizi: her origin ayrı indeksle (Cors__AllowedOrigins__1=... vb.)
Cors__AllowedOrigins__0=http://localhost:3200
# Audit IP HMAC anahtarı (sır, en az 32 bayt). Boş = IP hash'i yazılmaz; kısa değer = API başlamaz.
Audit__IpHashKey=
# Gözlemlenebilirlik (docs/operations/observability.md). Boş = OpenTelemetry kapalı; hiçbir veri dışarı gitmez.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
# Sağlayıcı API anahtarı başlığı (sır)
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
# none (varsayılan) | otel
ErrorTracking__Provider=
# Readiness iş kuyruğu eşikleri (varsayılan 00:05:00 / 00:30:00)
Health__QueueLagDegradedAfter=
Health__QueueLagUnhealthyAfter=
Anthropic__ApiKey=
Storage__SupabaseUrl=https://<supabase-project-ref>.supabase.co
Storage__ServiceKey=
# Push (FCM, docs/operations/push-and-captcha.md). Enabled=true iken servis hesabı JSON'u zorunlu, yoksa API başlamaz.
Push__Enabled=false
# Sır: Firebase servis hesabı JSON anahtarının tamamı (yalnızca API host secret'ı)
Push__ServiceAccountJson=
# Yalnızca yerel: repo dışındaki anahtar dosyasının yolu (Push__ServiceAccountJson yerine)
Push__ServiceAccountFile=
# Opsiyonel; boşsa anahtardaki project_id
Push__ProjectId=

# --- Web (apps/web) — NEXT_PUBLIC_ değişkenleri tarayıcıya gider; sır koymayın ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:5280
NEXT_PUBLIC_SUPABASE_URL=https://<supabase-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opsiyonel Cloudflare Turnstile site anahtarı (herkese açık). Boş = CAPTCHA kapalı. Gizli anahtar buraya değil,
# yalnızca Supabase Dashboard → Authentication → Bot protection'a girilir (docs/operations/environments.md §2.1).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Local docker compose (infra/docker/compose.yml) ---
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
BAYIOS_APP_PASSWORD=change-me-local-only
BAYIOS_MIGRATOR_PASSWORD=change-me-local-only
