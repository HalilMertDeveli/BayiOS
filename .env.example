# BayiOS — örnek ortam değişkenleri. GERÇEK DEĞER YAZMAYIN.
# Kopyalayın: .env (repo'ya girmez). Preview/production değerleri sağlayıcıların secret yönetiminde tutulur.

# --- API (services/api) ---
# Çalışma zamanı bağlantısı: yalnızca bayios_app rolü (NOBYPASSRLS, tablo sahibi değil).
ConnectionStrings__Default=Host=localhost;Port=5432;Database=bayios;Username=bayios_app;Password=change-me-local-only
# Yalnızca migration adımı (dotnet ef database update / CI): bayios_migrator. API'ye verilmez.
ConnectionStrings__Migrator=Host=localhost;Port=5432;Database=bayios;Username=bayios_migrator;Password=change-me-local-only
Auth__Authority=https://<supabase-project-ref>.supabase.co/auth/v1
Auth__Audience=authenticated
# Opsiyonel; varsayılan {Auth__Authority}/.well-known/jwks.json
Auth__JwksUrl=
# Yalnızca yerel Supabase CLI (http) için false; bkz. infra/supabase/local/README.md
Auth__RequireHttpsMetadata=
# Dizi: her origin ayrı indeksle (Cors__AllowedOrigins__1=... vb.)
Cors__AllowedOrigins__0=http://localhost:3200
Anthropic__ApiKey=
Storage__SupabaseUrl=https://<supabase-project-ref>.supabase.co
Storage__ServiceKey=

# --- Web (apps/web) — NEXT_PUBLIC_ değişkenleri tarayıcıya gider; sır koymayın ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:5280
NEXT_PUBLIC_SUPABASE_URL=https://<supabase-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Local docker compose (infra/docker/compose.yml) ---
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432
BAYIOS_APP_PASSWORD=change-me-local-only
BAYIOS_MIGRATOR_PASSWORD=change-me-local-only
