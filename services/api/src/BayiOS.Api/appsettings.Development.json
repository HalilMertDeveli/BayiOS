{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3200" ]
  },
  // Local development only: the demo seeder (apps/web/e2e-local/demo) writes hundreds of records a second as one
  // user. Every other environment uses the threat-model §6.5 defaults (300 reads / 60 writes per minute).
  "RateLimiting": {
    "ReadsPerMinute": 100000,
    "WritesPerMinute": 100000
  }
}
