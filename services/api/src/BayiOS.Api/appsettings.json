{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "Enabled": true,
    "ReadsPerMinute": 300,
    "WritesPerMinute": 60
  },
  "Ai": {
    "Enabled": false,
    "Model": "claude-opus-5-5",
    "Effort": "low"
  },
  "Push": {
    "Enabled": false
  }
}
