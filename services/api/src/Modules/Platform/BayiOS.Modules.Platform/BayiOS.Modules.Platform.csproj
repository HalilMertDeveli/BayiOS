<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Owns the cross-cutting `platform` schema (idempotency keys; later outbox and jobs) and its EF Core migrations
    (ADR 0005). The runtime code using these tables lives in BayiOS.SharedKernel and talks to them with raw SQL.
  -->
  <PropertyGroup>
    <RootNamespace>BayiOS.Modules.Platform</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BayiOS.IntegrationTests" />
  </ItemGroup>

</Project>
