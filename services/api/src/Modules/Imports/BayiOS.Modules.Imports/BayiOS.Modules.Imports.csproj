<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BayiOS.Modules.Imports</RootNamespace>
    <!-- CA1716: "Imports" is a VB keyword. The module name follows the architecture docs; there are no VB consumers. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\BayiOS.SharedKernel\BayiOS.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BayiOS.Api" />
    <InternalsVisibleTo Include="BayiOS.UnitTests" />
    <InternalsVisibleTo Include="BayiOS.IntegrationTests" />
  </ItemGroup>

</Project>
