# BayiOS web — variable NAMES only. Copy to .env.local (git-ignored) and fill in.
# Every NEXT_PUBLIC_ value is shipped to the browser: never put a secret here
# (no service-role key, no database URL).
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional: Cloudflare Turnstile site key (public). Empty = no CAPTCHA (local/dev/e2e). The secret key never goes
# here — it lives only in Supabase Dashboard -> Authentication -> Bot protection. docs/operations/environments.md 2.1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
