// Types for the Playwright specs that drive the demo seeder (seeder.mjs is plain Node ESM so the CLI runs without a
// TypeScript toolchain).
import type { Api, StackConfig } from "./stack.mjs";

export interface DemoOwner {
  email: string;
  password: string;
  fullName: string;
}

export interface DemoVariant {
  id: string;
  productId: string;
  barcode: string | null;
  price: number;
  unit: string;
  category: string;
  name?: string;
}

export interface WhatsappIntent {
  raw: string;
  match: string;
  sku: string;
  quantity: number;
}

export interface DemoCustomer {
  id: string;
  /** Default shipping address. */
  addressId: string;
  /** Default billing address (#136). */
  billingAddressId: string;
  code: string;
  name: string;
  group: string;
}

export interface DemoDefinition {
  code: "genel" | "motor" | "led";
  sector: string;
  tenant: { name: string; slug: string };
  owner: { email: string; fullName: string };
  /** Members invited by the seeder (generic demo): role + synthetic e-mail; passwords are generated by the caller. */
  team?: { role: string; email: string; fullName: string }[];
  orders: { target: string; customer: number; lines: [string, number][]; priority?: string; assignTo?: string; deliveryInDays?: number }[];
  importProducts: { sku: string; barcode: string; name: string; unit: string; category: string; price: number }[];
  priceLists: { defaultName: string; dealer: { name: string; group: string; discountPercent: number }[] };
  whatsapp: { customer: number; text: string; lines: WhatsappIntent[] };
}

export interface DemoCounts {
  products: number;
  variants: number;
  barcodes: number;
  warehouses: number;
  locations: number;
  priceLists: number;
  dealerGroups: number;
  customers: number;
  importJobs: number;
  whatsappParses: number;
  orders: number;
  ordersByStatus: Record<string, number>;
  partialFulfilment: number;
  /** Orders whose detail carries a billing address (#136). */
  ordersWithBillingAddress: number;
  /** Minimum stock thresholds (#137): rows (defaults + per-warehouse overrides). */
  stockThresholds: number;
  /** Critical-stock report in thresholds mode, all warehouses; and with out-of-stock variants without a minimum. */
  criticalStock: number;
  criticalStockWithOutOfStock: number;
  whatsappOrders: number;
  /** Active members per role (owner + invited team). */
  membersByRole: Record<string, number>;
  /** Open / in-progress picking tasks per priority (low, normal, high, urgent). */
  activeTasksByPriority: Record<string, number>;
  assignedActiveTasks: number;
  /** Two-stage transfers per status (in_transit, received, closed, …) and those with a discrepancy. */
  transfersByStatus: Record<string, number>;
  transfersWithDiscrepancy: number;
  stockCountsByStatus: Record<string, number>;
}

export interface DemoTeamMember {
  role: string;
  email: string;
  password: string;
  fullName: string;
}

export interface SeededMember {
  userId: string;
  email: string;
  fullName: string;
  role: string;
  /** The member's own API session, tenant selected. */
  api: Api;
}

export interface SeededDemo {
  skipped: boolean;
  def: DemoDefinition;
  api: Api;
  tenantId: string;
  userId: string;
  warehouses: Record<string, { id: string; name: string; usesLocations: boolean; locations: Record<string, { id: string; code: string }> }>;
  variants: Record<string, DemoVariant>;
  stock: Record<string, { main: number; shop: number }>;
  customers: DemoCustomer[];
  priceLists: { default: string; dealer: Record<string, { id: string; name: string; discountPercent: number }> };
  orders: { target: string; id: string; number: string; status: string; fulfillmentStatus: string }[];
  /** Invited team by role (empty without `team`). */
  members: Record<string, SeededMember>;
  relocations: { sku: string; quantity: number; from: string; to: string }[];
  transfers: { id: string; number: string; status: string; hasDiscrepancy: boolean }[];
  stockCount: { id: string; number: string; status: string; shelf: string; lines: number; counted: number } | null;
  /** Minimum stock thresholds the seeder set (#137). */
  thresholds: {
    critical: { sku: string; available: number; min: number }[];
    fine: { sku: string; available: number; min: number }[];
    override: { sku: string; warehouse: string; warehouseId: string; available: number; min: number };
    outOfStock: string[];
  };
  counts: DemoCounts;
  seconds: number;
}

export const DEMOS: Record<"genel" | "motor" | "led", (size?: "full" | "small") => DemoDefinition>;
export const DEFAULT_DEMO: "genel";

export function seedDemo(p: {
  cfg: StackConfig;
  demo: "genel" | "motor" | "led";
  size?: "full" | "small";
  owner: DemoOwner;
  team?: DemoTeamMember[];
  tenant?: { name: string; slug: string };
  include?: { importCatalog?: boolean; orders?: boolean; whatsapp?: boolean };
  log?: (line: string) => void;
}): Promise<SeededDemo>;

export function runCatalogImport(
  api: Api,
  def: DemoDefinition,
  priceListId: string,
  log?: (line: string) => void,
): Promise<{ job: { id: string; status: string; progress: { created: number; updated: number; failed: number } }; variants: Record<string, DemoVariant> }>;

export function summarize(api: Api): Promise<DemoCounts>;
