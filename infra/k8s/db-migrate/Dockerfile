# syntax=docker/dockerfile:1
#
# BayiOS database bootstrap + migration image for Kubernetes (kind rehearsal, docs/operations/kubernetes.md).
# It packages the SAME scripts the deploy pipeline uses — nothing is re-implemented here:
#   infra/supabase/bootstrap/bootstrap.sh   roles, extensions, (Supabase-only) access-token hook, verify.sql
#   infra/deploy/apply-migrations.sh        idempotent EF Core scripts as bayios_migrator, then verify.sql
# plus the EF Core scripts themselves, generated by infra/ci/ef-migrations.sh (OUT_DIR, with manifest.txt).
#
# Build (from the repo root, after `OUT_DIR=<dir> bash infra/ci/ef-migrations.sh`):
#   docker build -f infra/k8s/db-migrate/Dockerfile --build-context migrations=<dir> -t bayios-db-migrate infra
#
# No passwords or URLs are baked in: the Helm Job injects them from a Secret at runtime.

ARG PG_IMAGE=postgres:17-bookworm@sha256:665dc7b37ac52a17e298511414c21d23ffa4e6a6ef6225b3e5d59c7afb35e994
FROM ${PG_IMAGE}

# Same relative layout as the repo, so the scripts' own path logic (REPO_ROOT, VERIFY_SQL) works unchanged.
COPY --chown=0:0 supabase/bootstrap/ /bayios/infra/supabase/bootstrap/
COPY --chown=0:0 deploy/apply-migrations.sh /bayios/infra/deploy/apply-migrations.sh
COPY --chown=0:0 k8s/db-migrate/db-migrate.sh /bayios/infra/k8s/db-migrate/db-migrate.sh
COPY --from=migrations --chown=0:0 . /bayios/migrations/

RUN test -s /bayios/migrations/manifest.txt \
      || { echo "manifest.txt missing: pass --build-context migrations=<OUT_DIR of infra/ci/ef-migrations.sh>" >&2; exit 1; }

# The postgres image's unprivileged user; the Job only needs a psql client.
USER postgres
WORKDIR /bayios
ENTRYPOINT ["bash", "/bayios/infra/k8s/db-migrate/db-migrate.sh"]
