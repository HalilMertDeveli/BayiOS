# BayiOS web (Next.js, Node 24) — self-hosted Linux deployment, see infra/linux/README.md.
# Installed to /etc/systemd/system by infra/linux/scripts/provision.sh. Settings: /etc/bayios/web.env (root:bayios 0640).
# Listens on loopback only; Nginx terminates TLS for app.<domain> and proxies here.

[Unit]
Description=BayiOS web
Documentation=https://github.com/HalilMertDeveli/BayiOS/blob/main/infra/linux/README.md
Wants=network-online.target
After=network-online.target bayios-api.service
ConditionPathExists=/opt/bayios/current/web/.next/BUILD_ID
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=bayios
Group=bayios
WorkingDirectory=/opt/bayios/current/web
ExecStart=/usr/bin/node /opt/bayios/current/web/node_modules/next/dist/bin/next start --port 3200 --hostname 127.0.0.1
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOME=/var/cache/bayios-web
EnvironmentFile=/etc/bayios/web.env
# .next/cache in every release is a symlink to this directory (deploy.sh); it is emptied on each deploy/rollback.
CacheDirectory=bayios-web
CacheDirectoryMode=0700
SyslogIdentifier=bayios-web
Restart=on-failure
# Node exits 143 on SIGTERM: a normal stop, not a failure.
SuccessExitStatus=143
RestartSec=5
TimeoutStopSec=20
LimitNOFILE=65536
TasksMax=256
MemoryHigh=448M
MemoryMax=512M

# --- Hardening (check with: systemd-analyze security bayios-web) ---
# No MemoryDenyWriteExecute: V8's JIT needs W+X mappings.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateUsers=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
UMask=0077
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
