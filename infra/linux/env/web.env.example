# /etc/bayios/web.env — BayiOS web (Next.js) on a Linux VPS (systemd EnvironmentFile of bayios-web.service).
# Variable NAMES only. Every NEXT_PUBLIC_ value is shipped to the browser: never put a secret here.
#
# The same file is used twice:
#   1. at BUILD time by infra/linux/deploy.sh (WEB_ENV_FILE=...): Next.js inlines NEXT_PUBLIC_* into the bundle;
#   2. at RUN time by systemd: next.config.ts builds the Content-Security-Policy from these values on start.
# Keep both copies identical; a change needs a new deploy (rebuild), not only a restart.

# Same origin as the site: nginx sends /api/* to Kestrel, so the browser calls https://<domain>/api/v1/...
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional Cloudflare Turnstile site key (public). Empty = no CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
