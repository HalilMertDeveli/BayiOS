# /etc/bayios/web.env — BayiOS web (Next.js) settings on the server (root:bayios, 0640). Read by bayios-web.service.
# NEXT_PUBLIC_* values are inlined into the bundle when the release is BUILT (build-release.sh); changing them here
# does not change the browser bundle — build and deploy a new release instead. Keep them identical to the build values
# so server-side code sees the same configuration. They are public: never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional: cap the V8 heap below the unit's MemoryMax (512M), e.g. --max-old-space-size=384
NODE_OPTIONS=
