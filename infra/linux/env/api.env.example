# /etc/bayios/api.env — BayiOS API on a Linux VPS (systemd EnvironmentFile of bayios-api.service).
# Variable NAMES only. Copy to /etc/bayios/api.env (root:root 0600) and fill in ON THE SERVER. Never commit values.
# systemd reads this file as root before dropping to the bayios-api user, so the service user cannot read it itself.
# Full list and meaning: .env.example (repo root) and docs/operations/environments.md.

# Production | Preview. Production turns on HSTS and the production checks.
ASPNETCORE_ENVIRONMENT=Production

# Runtime connection: ONLY the bayios_app role (NOBYPASSRLS, not table owner). Never postgres / service-role.
# Use sslmode=require for a remote database (e.g. Supabase).
ConnectionStrings__Default=

# Supabase Auth (JWT validation via JWKS).
Auth__Authority=
Auth__Audience=authenticated
Auth__JwksUrl=

# The public web origin, e.g. https://bayios.example.com (one index per origin).
Cors__AllowedOrigins__0=

# Secret, at least 32 bytes. Empty = audit IP hash is not written.
Audit__IpHashKey=

# Optional: OpenTelemetry (empty endpoint = off, nothing leaves the server).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=bayios-api

# Optional integrations (empty = feature off).
Anthropic__ApiKey=
Storage__SupabaseUrl=
Storage__ServiceKey=
Push__Enabled=false
Push__ProjectId=
Push__ServiceAccountJson=
