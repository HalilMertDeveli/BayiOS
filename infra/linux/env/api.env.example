# /etc/bayios/api.env — BayiOS API settings on the server (root:bayios, 0640). Read by bayios-api.service.
# Variable NAMES only in the repository: real values are typed in on the server (or come from a password manager)
# and are never committed, pasted into issues, or printed in logs. Full list: /.env.example at the repo root.
# After editing: sudo systemctl restart bayios-api && bayios-healthcheck --ready

# Runtime connection: ONLY the bayios_app role (NOBYPASSRLS, not table owner), TLS required (Supabase pooler/direct).
# Never postgres/service_role, never the bayios_migrator connection (migrations run in the pipeline, not here).
ConnectionStrings__Default=
# Supabase Auth issuer, e.g. https://<project-ref>.supabase.co/auth/v1
Auth__Authority=
Auth__Audience=authenticated
# The web origin (array: add Cors__AllowedOrigins__1=... for more).
Cors__AllowedOrigins__0=https://app.example.com
# HMAC key for audit IP hashes: a secret of at least 32 bytes (e.g. `openssl rand -base64 48`). Empty = no IP hash.
Audit__IpHashKey=
# Nginx is the only proxy and Kestrel listens on 127.0.0.1: trust X-Forwarded-For/-Proto so the API sees client IPs.
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Optional (see /.env.example and docs/operations/observability.md)
Storage__SupabaseUrl=
Storage__ServiceKey=
Anthropic__ApiKey=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=
